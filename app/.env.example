# App settings. Copy to app/.env and fill in (Expo reads app/.env by itself).
# app/.env is git-ignored. For a release build these same three names are set in EAS instead
# (docs/INSTALL.md), because app/.env is not uploaded to the build service.
#
# EVERYTHING HERE IS BUNDLED INTO THE APK, where anyone can read it. Only public values go in
# this file. Never the Groq or Gemini keys, never the database URL, never Supabase's secret
# (service_role) key: those belong in backend/.env only.
#
# If a value is missing or wrong the app opens on a "this build is not set up" screen that names
# it (app/src/lib/env-check.ts).

# Your Supabase project URL. Supabase dashboard -> Project Settings -> API -> Project URL.
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# Supabase's *publishable* (anon) key, from the same page. Safe to ship: row-level security and
# the backend decide what a signed-in learner may do.
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Where the backend is.
# - Developing with Expo Go on a phone: your computer's LAN address, e.g. http://192.168.1.20:8000
#   ("localhost" would be the phone itself).
# - Release build: the Render URL, e.g. https://lumen-backend.onrender.com . It must be https:
#   Android blocks plain http in release builds.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
