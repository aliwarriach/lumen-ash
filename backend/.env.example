# Backend settings. Copy to backend/.env and fill in.
# backend/.env is git-ignored: never commit real values. On Render, set the same names in the
# dashboard (render.yaml lists the ones that have no default).
#
# Lines starting with "#" show the default: uncomment one only to change it.
# Every name here is read by backend/app/core/config.py, which refuses to start with a clear
# message if a required value is missing or malformed.

# ---------------------------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------------------------

# local | production. ("test" is set by the test suite itself, which then ignores this file.)
ENVIRONMENT=local

# Your Supabase project URL. Supabase dashboard -> Project Settings -> API -> Project URL.
# The backend uses it to check login tokens. Must start with https://
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co

# The database. Supabase dashboard -> Connect -> "Session pooler" string (IPv4; the direct
# connection is IPv6-only on the free plan). Change its "postgresql://" prefix to
# "postgresql+psycopg://". Contains the database password: keep it secret.
DATABASE_URL=postgresql+psycopg://postgres.YOUR-PROJECT-REF:YOUR-PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------------------------
# AI providers (secret; backend only, never in the app). All optional: with none set, everything
# except the AI features still works.
# ---------------------------------------------------------------------------------------------

# Groq key: https://console.groq.com/keys . The provider the app is verified against.
GROQ_API_KEY=
# A second Groq key, tried when the first is rate limited or stops working. Each key is counted
# on its own. Optional.
GROQ_BACKUP_API_KEY=
# Gemini key: https://aistudio.google.com/apikey . It must belong to a project on the FREE tier.
# A key from a prepaid project with no credit answers "402 prepayment credits are depleted" and
# is skipped.
GEMINI_API_KEY=

# ---------------------------------------------------------------------------------------------
# AI behaviour (optional; the defaults are shown)
# ---------------------------------------------------------------------------------------------

# Model names. Providers retire models often (the first Groq default lasted under a year), so
# check each provider's console now and then. After changing one, measure it on German:
#   python -m app.ai.evaluate
# GROQ_MODEL=openai/gpt-oss-120b
# GEMINI_MODEL=gemini-2.5-flash-lite

# Groq's current models think before answering; "low" keeps that short and cheap.
# Use low, medium or high. Leave EMPTY for a model without a reasoning setting.
# GROQ_REASONING_EFFORT=low

# Providers to try, in order. Swap or drop one here; no code change needed.
# Names: groq, groq_backup, gemini. One without a key is skipped.
# AI_PROVIDER_ORDER=groq,groq_backup,gemini

# Seconds to wait for one provider before trying the next.
# AI_REQUEST_TIMEOUT_SECONDS=20

# Where each provider's API lives. Change only to go through a proxy.
# GROQ_API_URL=https://api.groq.com/openai/v1
# GEMINI_API_URL=https://generativelanguage.googleapis.com/v1beta

# ---------------------------------------------------------------------------------------------
# AI limits (optional; the defaults are shown). Days are UTC.
# ---------------------------------------------------------------------------------------------

# What one learner may use per day, over all AI features.
# AI_USER_DAILY_REQUESTS=40
# AI_USER_DAILY_TOKENS=60000
# Per-feature daily caps, as JSON. Features: sentence_coach, message_capture, exercise_help.
# AI_FEATURE_DAILY_CAPS={"sentence_coach": 25, "message_capture": 10, "exercise_help": 15}
# AI requests one learner may make per minute (stops double taps and loops).
# AI_BURST_PER_MINUTE=6

# Shared daily ceilings per provider, across all learners: about 80% of the provider's real
# limit, so we stop before they refuse us. Groq allows 1,000 requests a day per key for
# openai/gpt-oss-120b (November 2026); its daily token limit is on https://console.groq.com
# under Limits. The backup key uses the same two ceilings, counted separately.
# GROQ_DAILY_REQUEST_CEILING=800
# GROQ_DAILY_TOKEN_CEILING=160000
# GEMINI_DAILY_REQUEST_CEILING=400
# GEMINI_DAILY_TOKEN_CEILING=

# Names (comma separated) to strip from text before it is sent to an AI provider or to
# LanguageTool, on top of phone numbers, emails and links, which are always removed.
# AI_REDACT_NAMES=Ali,Sara

# ---------------------------------------------------------------------------------------------
# Grammar checking (optional)
# ---------------------------------------------------------------------------------------------

# LanguageTool finds errors in the sentence coach and checks AI answers. The public API is free
# and allows about 20 requests a minute per IP. Set to EMPTY to switch LanguageTool off.
# LANGUAGETOOL_URL=https://api.languagetool.org/v2/check
# LANGUAGETOOL_TIMEOUT_SECONDS=10
# Our own cap on requests per minute, kept under LanguageTool's.
# LANGUAGETOOL_PER_MINUTE=15

# ---------------------------------------------------------------------------------------------
# Community forum (optional; the defaults are shown)
# ---------------------------------------------------------------------------------------------

# Emails (comma separated) of the people who may delete anyone's message in the group chat.
# Use the email each one signs in with. Everyone can always delete their own messages.
# With nobody listed, a message can only be removed by its author (or by you, in the database).
COMMUNITY_MODERATOR_EMAILS=
# Messages one person may post per minute. Stops a flood, or a stuck phone, reaching everyone.
# COMMUNITY_MESSAGES_PER_MINUTE=20
# Phones that may be connected to the live chat at the same time.
# COMMUNITY_MAX_CONNECTIONS=200

# ---------------------------------------------------------------------------------------------
# Error reporting (optional)
# ---------------------------------------------------------------------------------------------

# Sentry DSN (Sentry -> Project Settings -> Client Keys). Empty = no error reports are sent.
# Reports never include what the learner wrote (see docs/privacy.md).
SENTRY_DSN=
